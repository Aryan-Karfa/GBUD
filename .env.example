# Application Configuration
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL=postgresql://gbud_user:gbud_password@localhost:5432/gbud_db?schema=public
TEST_DATABASE_URL=postgresql://gbud_user:gbud_password@localhost:5432/gbud_test_db?schema=public

# Authentication Configuration (JWT)
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client Configuration
VITE_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

