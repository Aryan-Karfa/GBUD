# ==============================================================================
# GBUD Backend API — Environment Configuration (.env.example)
# ==============================================================================
# This file serves as the template for backend environment variables.
# Copy this file to .env in local development or configure these variables
# directly in your production secrets manager / deployment environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & PORT
# ------------------------------------------------------------------------------
# Environment mode: 'development' | 'production' | 'test'
# In 'production', missing JWT secrets or insecure configurations will fail startup.
NODE_ENV=production

# Server listening port (default: 4000)
API_PORT=4000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string utilized by Prisma ORM.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Production recommendation: Configure connection pooling and SSL mode (?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gbud?schema=public

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECRETS (Required in Production)
# ------------------------------------------------------------------------------
# Strong cryptographically random secrets (minimum 32 characters recommended).
# Generate via: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_a_secure_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_min_32_chars

# Token Expirations (zeit/ms format, e.g., '15m', '7d', '1h')
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# In production: If omitted or empty, browser CORS is disabled by default (false).
# This is safe and recommended for native Android clients which do not send Origin headers.
# If web dashboard or admin tool access is required, specify the explicit domain(s):
# CORS_ORIGIN=https://admin.gbud.app
CORS_ORIGIN=
