# ==============================================================================
# GBUD Mobile Application — Environment Configuration (.env.example)
# ==============================================================================
# In Expo SDK 52, environment variables prefixed with EXPO_PUBLIC_ are bundled
# into client JavaScript at build time.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUCTION RELEASE BUILD (Required for APK/AAB release builds)
# ------------------------------------------------------------------------------
# Production builds MUST use HTTPS. Insecure HTTP URLs are strictly rejected at runtime.
EXPO_PUBLIC_API_URL=https://gbud-production.up.railway.app

# ------------------------------------------------------------------------------
# 2. LOCAL DEVELOPMENT & EMULATOR (Development Only)
# ------------------------------------------------------------------------------
# Android Emulator: Isolated virtual network where 10.0.2.2 accesses host localhost
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Physical Device on local Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# Standard Localhost (iOS Simulator / Web Dev):
# EXPO_PUBLIC_API_URL=http://localhost:4000
