# GBUD Mobile Application Environment Variables

# ANDROID EMULATOR:
# The Android emulator runs in an isolated virtual network where 10.0.2.2 accesses host localhost:
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# HOST / LAN PHYSICAL DEVICE:
# For physical Android testing on the same Wi-Fi network, point to your workstation's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# LOCAL / SIMULATOR DEFAULT:
# EXPO_PUBLIC_API_URL=http://localhost:4000
